generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-document app state (mirrors former database.json) with optimistic locking.
model AppState {
  id        Int      @id @default(1)
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}
